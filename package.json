{
  "name": "d-pomodoro",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "echo 'Nothing to build yet...'",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run --passWithNoTests",
    "format": "prettier --write .",
    "prepare": "git config core.hooksPath .git-hooks || echo 'Not in a git repo'"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "lint-staged": "^17.1.1",
    "prettier": "^3.9.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
