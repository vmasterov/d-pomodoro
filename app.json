{
  "expo": {
    "name": "d-pomodoro",
    "slug": "d-pomodoro",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "dpomodoro",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.anonymous.dpomodoro"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.vm7.dpomodoro",
      "versionCode": 1
    },
    "experiments": {
      "reactCompiler": true
    },
    "plugins": [
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "b8140461-a507-417b-a35b-0ea2b0e340f3"
      }
    }
  }
}
