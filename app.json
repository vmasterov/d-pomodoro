{
  "expo": {
    "name": "VM таймер",
    "slug": "d-pomodoro",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "dpomodoro",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.anonymous.dpomodoro"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.dpomodoro",
      "permissions": ["android.permission.SCHEDULE_EXACT_ALARM"]
    },
    "experiments": {
      "reactCompiler": true
    },
    "plugins": ["@react-native-community/datetimepicker"],
    "extra": {
      "eas": {
        "projectId": "b8140461-a507-417b-a35b-0ea2b0e340f3"
      }
    }
  }
}
