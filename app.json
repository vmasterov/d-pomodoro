{
  "expo": {
    "name": "d-pomodoro",
    "slug": "d-pomodoro",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "dpomodoro",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.anonymous.dpomodoro"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.dpomodoro"
    },
    "experiments": {
      "reactCompiler": true
    },
    "plugins": [
      "@react-native-community/datetimepicker"
    ]
  }
}
